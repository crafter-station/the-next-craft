# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# generated role invitation previews
/.invitation-output/
/.email-output/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Salidas de gran formato. Los generadores en scripts/generate-*.mjs son
# deterministas, así que se rehacen con un comando y no vale la pena cargar
# decenas de MB al repo. La excepción es el PDF que se manda a imprenta.
public/brand-assets/print/**
!public/brand-assets/print/the-next-craft-photocall-300x220.pdf
